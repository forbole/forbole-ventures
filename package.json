{
  "name": "forbole-ventures",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "resolutions": {
    "@babel/runtime": "7.29.7",
    "@opennextjs/cloudflare/**/minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "optimize:assets": "svgo --folder src/assets --recursive --multipass && svgo --folder public/images --recursive --multipass"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/styles": "^6.4.8",
    "@opennextjs/cloudflare": "^1.20.2",
    "classnames": "^2.5.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "svgo": "^4.0.2",
    "typescript": "6.0.3",
    "wrangler": "^4.114.0"
  }
}
